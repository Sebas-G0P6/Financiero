<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Formulario: rango de fechas + botón que dispara la consulta a Oracle -->
        <record id="view_fenalco_reportes_unoe_form" model="ir.ui.view">
            <field name="name">fenalco.reportes.interfaz.unoe.form</field>
            <field name="model">fenalco.reportes.interfaz.unoe</field>
            <field name="arch" type="xml">
                <form edit="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="_fv_fecha_inicio"/>
                            </group>
                            <group>
                                <field name="_fv_fecha_fin"/>
                            </group>
                        </group>
                        <br/>
                        <br/>
                    </sheet>
                    <footer>
                        <button name="fv_generar_consolidado_caja" string="Generar Reporte" type="object" default_focus="1" class="oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción para generar un reporte nuevo como ventana modal (equivalente al botón custom del 15) -->
        <record id="action_fenalco_reporte_consolidado_new" model="ir.actions.act_window">
            <field name="name">Generar Reporte Consolidado Recaudos</field>
            <field name="res_model">fenalco.reportes.interfaz.unoe</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_fenalco_reportes_unoe_form"/>
            <field name="target">new</field>
        </record>

        <!-- Historial de reportes generados (cabecera con totales por corrida) -->
        <record id="view_fenalco_reportes_unoe_tree" model="ir.ui.view">
            <field name="name">fenalco.reportes.interfaz.unoe.tree</field>
            <field name="model">fenalco.reportes.interfaz.unoe</field>
            <field name="arch" type="xml">
                <list string="MetodoPagos" default_order="create_date desc" create="0">
                    <header>
                        <button name="%(action_fenalco_reporte_consolidado_new)d" type="action" string="Generar Reporte" display="always" class="btn-primary"/>
                    </header>
                    <field name="create_date" string="F. Creación"/>
                    <field name="create_uid" string="Usuario" widget="many2one_avatar"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="_fv_fecha_inicio" string="F. Inicio" readonly="1"/>
                    <field name="_fv_fecha_fin" string="F. Fin" readonly="1"/>
                    <field name="_fv_fecha_ultimo_pago_aplicado" decoration-success="1" readonly="1"/>
                    <field name="_total_recaudo_caja" string="P. Caja" readonly="1" decoration-info="1" class="font-weight-bold" widget="monetary"/>
                    <field name="_total_recaudo_cobranzas" string="P. Cobranzas" readonly="1" decoration-info="1" class="font-weight-bold" widget="monetary"/>
                    <field name="_total_recaudo_manuales_open" string="P. Manual Open" readonly="1" decoration-info="1" class="font-weight-bold" widget="monetary"/>
                    <field name="_total_recaudo" widget="monetary" string="Total Pagos" readonly="1" decoration-success="1" class="font-weight-bold"/>
                    <button name="ver_reporte_caja" type="object" string="Ver informe"/>
                </list>
            </field>
        </record>

        <!-- Detalle del recaudo consolidado (resultado del reporte) -->
        <record id="view_fenalco_reportes_consolidado_tree" model="ir.ui.view">
            <field name="name">fenalco.reportes.interfaz.consolidado.tree</field>
            <field name="model">fenalco.reportes.interfaz.consolidado</field>
            <field name="arch" type="xml">
                <list editable="bottom" string="ReporteConsolidado" expand="0" default_order="_fecha_pago_aplicado DESC" limit="15" create="0">
                    <field name="currency_id" column_invisible="1"/>
                    <field name="_validado" widget="boolean_toggle" optional="hide"/>
                    <field name="_no_recibo_prefijo" readonly="1"/>
                    <field name="_fecha_pago_aplicado" readonly="1"/>
                    <field name="_no_liquidacion" optional="show" readonly="1"/>
                    <field name="_no_secuencia_tucompra" optional="show" readonly="1"/>
                    <field name="_comprobante" optional="show" readonly="1"/>
                    <field name="_cedula_deudor" readonly="1"/>
                    <field name="_cajero" readonly="1"/>
                    <field name="_fv_account_journal"/>
                    <field name="_hora" optional="hide" readonly="1"/>
                    <field name="_fv_estado" readonly="1" optional="hide" widget="badge"
                           decoration-danger="_fv_estado == 'invalido' or _fv_estado == 'cancelado'"
                           decoration-info="_fv_estado == 'recaudado'"
                           decoration-success="_fv_estado in ('pendiente', 'recaudado_externo')"/>
                    <field name="_fv_estado_externo" readonly="1" optional="hide" widget="badge"
                           decoration-danger="_fv_estado_externo == 'anulado'"
                           decoration-success="_fv_estado_externo in ('aprobado')"/>
                    <field name="_valor" decoration-success="1" class="font-weight-bold" widget="monetary" sum="Total" decoration-bf="1" readonly="1" force_save="1"/>
                </list>
            </field>
        </record>

        <record id="view_fenalco_reportes_consolidado_search" model="ir.ui.view">
            <field name="name">fenalco.reportes.interfaz.consolidado.search</field>
            <field name="model">fenalco.reportes.interfaz.consolidado</field>
            <field name="arch" type="xml">
                <search string="Reportes">
                    <field name="_no_recibo_prefijo" string="Número de Recibo"/>
                    <field name="_comprobante" string="Número de Comprobante"/>

                    <separator/>
                    <filter string="Recaudo Consolidado cobranzas" name="filter_cobranzas" domain="[('_origen', 'in', ('cobranzas', 'pago_manual_open'))]"/>
                    <filter string="Recaudo Pagos Manuales Open" name="filter_manuales_open" domain="[('_origen', '=', 'pago_manual_open')]"/>
                    <filter string="Aprobados" name="filter_aprobados" domain="[('_fv_estado_externo', '=', 'aprobado')]"/>

                    <group expand="1" string="Group By">
                        <filter name="group_by_create_uid" string="Agrupar por usuarios" context="{'group_by': 'create_uid'}"/>
                        <filter name="group_by_grupo_producto" string="Agrupar grupo producto" context="{'group_by': '_grupo_producto'}"/>
                        <filter name="group_by_origen" string="Agrupar origen de pago" context="{'group_by': '_origen'}"/>
                        <filter name="group_by_fv_account_journal" string="Agrupar por forma de pago" context="{'group_by': '_fv_account_journal'}"/>
                    </group>

                    <searchpanel>
                        <field name="_fv_estado_externo" select="multi" string="Estado Pago" icon="fa-th-large" enable_counters="1"/>
                        <field name="_grupo_producto" select="multi" string="Grupo Producto" icon="fa-th-large" enable_counters="1"/>
                        <field name="_origen" select="multi" string="Origen de Pago" icon="fa-th-large" enable_counters="1"/>
                        <field name="create_uid" select="multi" string="Usuario" icon="fa-users" enable_counters="1"/>
                        <field name="_fv_account_journal" select="multi" string="Metodos de Pago" icon="fa-credit-card-alt" enable_counters="1"/>
                    </searchpanel>
                    <separator/>
                </search>
            </field>
        </record>

        <!-- Acción del menú: historial de reportes generados, con opción de crear uno nuevo -->
        <record id="action_fenalco_reporte_consolidado" model="ir.actions.act_window">
            <field name="name">Listado Consolidado de Recaudos</field>
            <field name="res_model">fenalco.reportes.interfaz.unoe</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
        </record>

        <record id="action_fenalco_reporte_consolidado_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_fenalco_reportes_unoe_tree"/>
            <field name="act_window_id" ref="action_fenalco_reporte_consolidado"/>
        </record>

        <record id="action_fenalco_reporte_consolidado_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_fenalco_reportes_unoe_form"/>
            <field name="act_window_id" ref="action_fenalco_reporte_consolidado"/>
        </record>

        <!-- Menú: Fenalco Recaudos → Reportes → Cuadre de Cajas → Listado Consolidado de Recaudos -->
        <menuitem name="Fenalco Recaudos" id="menu_root_fenalco_cuadre_cajas" groups="group_cuadre_cajas_user" sequence="1"/>
        <menuitem name="Reportes" id="menu_reportes_fenalco_cuadre_cajas" parent="menu_root_fenalco_cuadre_cajas" sequence="10"/>
        <menuitem name="Cuadre de Cajas" id="menu_cuadre_cajas" parent="menu_reportes_fenalco_cuadre_cajas" sequence="10"/>
        <menuitem name="Listado Consolidado de Recaudos" id="menu_listado_consolidado_recaudos" parent="menu_cuadre_cajas" action="action_fenalco_reporte_consolidado" sequence="10"/>

    </data>
</odoo>
